# ========================================================
# GHOSTPROTOCOL CONFIGURATION
# ========================================================

# OpenRouter AI Engine
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Secondary Fallback: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NEAR Protocol Configuration
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
CONTRACT_ID=ghostprotocol.testnet
OWNER_ACCOUNT_ID=owner.testnet
AGENT_ACCOUNT_ID=ghost-agent.testnet
AGENT_PRIVATE_KEY=
BENEFICIARY_ACCOUNT_ID=heir.testnet
BENEFICIARY_TG=@heir_telegram

# Proof-of-Life Watchman Settings
DEMO_MODE=true
WARNING_THRESHOLD_MS=5000
